# App
# Development: NODE_ENV=development (default). Dev JWT/platform placeholders are allowed.
# Production: NODE_ENV=production requires a unique JWT_SECRET (min 32 chars, not a placeholder)
# and a unique PLATFORM_OWNER_PASSWORD (not the development default).
NODE_ENV=development
JWT_SECRET=change-me-use-32-chars-minimum-secret
DATABASE_URL=sqlite:///./finup_pos.db
APP_URL=http://127.0.0.1:8001
# CORS: explicit origins only. Never use * in production (unsafe with credentials).
# Production empty list = same-origin SPA only (recommended for https://fixen.uz monolith).
CORS_ORIGINS=http://127.0.0.1:8001,http://localhost:8001

# Platform admin (#/platform)
PLATFORM_OWNER_LOGIN=platform
PLATFORM_OWNER_PASSWORD=platform123

# Click / Payme SaaS billing webhooks (fail-closed):
# empty CLICK_SECRET or PAYME_KEY -> webhook is REJECTED
CLICK_SERVICE_ID=
CLICK_MERCHANT_ID=
CLICK_SECRET=
PAYME_MERCHANT_ID=
PAYME_KEY=


# AI Assistant (backend only — never expose to frontend)
AI_ENABLED=true
AI_PROVIDER=openai
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini
AI_MAX_TOKENS=800
AI_TIMEOUT_SEC=25
AI_MAX_HISTORY=12
AI_MAX_MESSAGE_CHARS=2000
AI_RATE_LIMIT=30
AI_RATE_WINDOW=3600
AI_TEMPERATURE=0.3
