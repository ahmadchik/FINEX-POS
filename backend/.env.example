# App
JWT_SECRET=change-me-use-32-chars-minimum-secret
DATABASE_URL=sqlite:///./finup_pos.db
APP_URL=http://127.0.0.1:8001
CORS_ORIGINS=http://127.0.0.1:8001,http://localhost:8001

# Platform admin (#/platform)
PLATFORM_OWNER_LOGIN=platform
PLATFORM_OWNER_PASSWORD=platform123

# Optional Click / Payme (empty = demo checkout)
CLICK_SERVICE_ID=
CLICK_MERCHANT_ID=
# Agar to'ldirilsa, webhook imzo tekshiriladi
CLICK_SECRET=
PAYME_MERCHANT_ID=
PAYME_KEY=


# AI Assistant (backend only — never expose to frontend)
AI_ENABLED=true
AI_PROVIDER=openai
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini
AI_MAX_TOKENS=800
AI_TIMEOUT_SEC=25
AI_MAX_HISTORY=12
AI_MAX_MESSAGE_CHARS=2000
AI_RATE_LIMIT=30
AI_RATE_WINDOW=3600
AI_TEMPERATURE=0.3
